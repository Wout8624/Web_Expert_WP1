<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="bg-gray-100 flex flex-col items-center justify-center h-screen">
<h1>Welcome!</h1>
    <br>
    <hr class="w-64">
    <br>
    <h2>Configured Routes</h2>
    <ul>
        {{#each routes}}
            <li><a href="/{{name}}">/{{name}}</a> - {{count}} items</li>
        {{/each}}
    </ul>
</body>
</html>