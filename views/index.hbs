<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body class="min-h-screen bg-carbon-black-950 text-carbon-black-200 antialiased">
<div class="pointer-events-none fixed inset-0 bg-gradient-to-br from-rich-mahogany-800 via-carbon-black-950 to-carbon-black-950"></div>
<div class="pointer-events-none fixed inset-0 bg-[radial-gradient(ellipse_at_top,var(--color-rich-mahogany-700)_0%,transparent_60%)] opacity-60"></div>
<div class="pointer-events-none fixed inset-0 bg-[radial-gradient(ellipse_at_bottom_right,var(--color-rich-mahogany-900)_0%,transparent_55%)]"></div>

<main class="relative mx-auto max-w-4xl px-4 py-16 sm:px-6 sm:py-24">
    <header class="text-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-soft-linen-700/60 bg-carbon-black-900/60 px-3 py-1 text-xs font-medium text-soft-linen-200 shadow-sm backdrop-blur">
            <span class="h-2 w-2 rounded-full bg-autumn-ember-500"></span>
            API is running
        </span>
        <h1 class="mt-6 text-4xl font-bold tracking-tight text-soft-linen-50 sm:text-5xl">
            Welcome!
        </h1>
        <p class="mx-auto mt-4 max-w-xl text-lg text-soft-linen-300">
            Browse the routes defined in your configuration. Run a request below to see its JSON response.
        </p>
        <div class="mx-auto mt-10 h-px w-40 bg-gradient-to-r from-transparent via-soft-linen-500 to-transparent"></div>
    </header>

    <section class="mt-16">
        <div class="mb-4 flex items-baseline justify-between">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-soft-linen-400">Configured Routes</h2>
            <span class="text-sm text-soft-linen-500">{{routes.length}} total</span>
        </div>

        <ul class="grid gap-4 sm:grid-cols-2">
            {{#each routes}}
                <li class="flex flex-col gap-5 rounded-xl border border-soft-linen-800/60 bg-carbon-black-900/70 p-5 shadow-lg shadow-black/30 backdrop-blur">
                    <div class="flex items-center gap-4">
                        <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-soft-linen-100 font-mono text-lg font-semibold text-rich-mahogany-700">/</div>
                        <div>
                            <p class="font-mono text-base font-semibold text-soft-linen-50">/{{name}}</p>
                            <p class="text-sm text-soft-linen-400">{{count}} items</p>
                        </div>
                    </div>

                    <div>
                        <label for="embed-{{name}}" class="mb-2 block text-xs font-semibold uppercase tracking-wider text-soft-linen-500">Embed</label>
                        <select id="embed-{{name}}" data-route="{{name}}"
                                class="embed-select w-full rounded-lg border border-soft-linen-800 bg-carbon-black-950 px-2 py-1.5 font-mono text-sm text-soft-linen-100 focus:border-soft-linen-400 focus:outline-none">
                        </select>
                    </div>

                    <div>
                        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-soft-linen-500">Get all</p>
                        <div class="mb-2 flex flex-wrap gap-2">
                            <select id="sort-{{name}}" aria-label="Sort by"
                                    class="rounded-lg border border-soft-linen-800 bg-carbon-black-950 px-2 py-1.5 font-mono text-sm text-soft-linen-100 focus:border-soft-linen-400 focus:outline-none">
                                <option value="">No sorting</option>
                            </select>
                            <select id="order-{{name}}" aria-label="Sort order"
                                    class="rounded-lg border border-soft-linen-800 bg-carbon-black-950 px-2 py-1.5 font-mono text-sm text-soft-linen-100 focus:border-soft-linen-400 focus:outline-none">
                                <option value="asc">asc</option>
                                <option value="desc">desc</option>
                            </select>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            <button type="button" data-route="{{name}}"
                                    class="run-all rounded-lg bg-soft-linen-100 px-3 py-1.5 text-sm font-semibold text-carbon-black-900 transition hover:bg-soft-linen-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-rich-mahogany-500">
                                Run
                            </button>
                            <button type="button" data-route="{{name}}" data-embed="true"
                                    class="run-all rounded-lg border border-rich-mahogany-500 bg-rich-mahogany-700/60 px-3 py-1.5 text-sm font-semibold text-soft-linen-50 transition hover:bg-rich-mahogany-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-soft-linen-300">
                                Run embedded
                            </button>
                        </div>
                    </div>

                    <div>
                        <label for="id-{{name}}" class="mb-2 block text-xs font-semibold uppercase tracking-wider text-soft-linen-500">Get by id</label>
                        <div class="flex flex-wrap gap-2">
                            <select id="id-{{name}}" data-route="{{name}}"
                                    class="id-select rounded-lg border border-soft-linen-800 bg-carbon-black-950 px-2 py-1.5 font-mono text-sm text-soft-linen-100 focus:border-soft-linen-400 focus:outline-none">
                            </select>
                            <button type="button" data-route="{{name}}"
                                    class="run-id rounded-lg bg-soft-linen-100 px-3 py-1.5 text-sm font-semibold text-carbon-black-900 transition hover:bg-soft-linen-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-rich-mahogany-500">
                                Run
                            </button>
                            <button type="button" data-route="{{name}}" data-embed="true"
                                    class="run-id rounded-lg border border-rich-mahogany-500 bg-rich-mahogany-700/60 px-3 py-1.5 text-sm font-semibold text-soft-linen-50 transition hover:bg-rich-mahogany-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-soft-linen-300">
                                Run embedded
                            </button>
                        </div>
                    </div>

                    <div>
                        <label for="body-{{name}}" class="mb-2 block text-xs font-semibold uppercase tracking-wider text-soft-linen-500">Create (POST)</label>
                        <textarea id="body-{{name}}" data-route="{{name}}" rows="5" spellcheck="false"
                                  class="body-input w-full rounded-lg border border-soft-linen-800 bg-carbon-black-950 px-2 py-1.5 font-mono text-sm text-soft-linen-100 focus:border-soft-linen-400 focus:outline-none">{}</textarea>
                        <button type="button" data-route="{{name}}"
                                class="run-post mt-2 rounded-lg bg-soft-linen-100 px-3 py-1.5 text-sm font-semibold text-carbon-black-900 transition hover:bg-soft-linen-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-rich-mahogany-500">
                            Run
                        </button>
                    </div>

                    <div>
                        <label for="put-id-{{name}}" class="mb-2 block text-xs font-semibold uppercase tracking-wider text-soft-linen-500">Update (PUT)</label>
                        <select id="put-id-{{name}}" data-route="{{name}}"
                                class="put-id-select mb-2 rounded-lg border border-soft-linen-800 bg-carbon-black-950 px-2 py-1.5 font-mono text-sm text-soft-linen-100 focus:border-soft-linen-400 focus:outline-none">
                        </select>
                        <textarea id="put-body-{{name}}" data-route="{{name}}" rows="5" spellcheck="false"
                                  class="w-full rounded-lg border border-soft-linen-800 bg-carbon-black-950 px-2 py-1.5 font-mono text-sm text-soft-linen-100 focus:border-soft-linen-400 focus:outline-none">{}</textarea>
                        <button type="button" data-route="{{name}}"
                                class="run-put mt-2 rounded-lg bg-soft-linen-100 px-3 py-1.5 text-sm font-semibold text-carbon-black-900 transition hover:bg-soft-linen-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-rich-mahogany-500">
                            Run
                        </button>
                    </div>

                    <div>
                        <label for="delete-id-{{name}}" class="mb-2 block text-xs font-semibold uppercase tracking-wider text-soft-linen-500">Delete</label>
                        <div class="flex flex-wrap gap-2">
                            <select id="delete-id-{{name}}" data-route="{{name}}"
                                    class="rounded-lg border border-soft-linen-800 bg-carbon-black-950 px-2 py-1.5 font-mono text-sm text-soft-linen-100 focus:border-soft-linen-400 focus:outline-none">
                            </select>
                            <button type="button" data-route="{{name}}"
                                    class="run-delete rounded-lg border border-rich-mahogany-500 bg-rich-mahogany-700/60 px-3 py-1.5 text-sm font-semibold text-soft-linen-50 transition hover:bg-rich-mahogany-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-soft-linen-300">
                                Delete
                            </button>
                        </div>
                    </div>
                </li>
            {{else}}
                <li class="col-span-full rounded-xl border border-dashed border-soft-linen-800 p-8 text-center text-carbon-black-400">
                    No routes configured yet. Add some to <code class="font-mono text-carbon-black-200">config.yaml</code>.
                </li>
            {{/each}}
        </ul>
    </section>

    <section id="result" class="mt-10 hidden">
        <div class="mb-4 flex items-baseline justify-between gap-4">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-soft-linen-400">Response</h2>
            <a id="result-url" href="#" target="_blank" class="truncate font-mono text-sm text-soft-linen-300 underline decoration-soft-linen-700 underline-offset-4 hover:text-soft-linen-100"></a>
        </div>
        <div class="overflow-hidden rounded-xl border border-soft-linen-800/60 bg-carbon-black-950/80 shadow-lg shadow-black/30">
            <div class="flex items-center gap-2 border-b border-soft-linen-900 px-4 py-2 text-xs">
                <span id="result-method" class="rounded bg-soft-linen-900 px-1.5 py-0.5 font-mono font-semibold text-soft-linen-200">GET</span>
                <span id="result-status" class="font-mono"></span>
            </div>
            <pre id="result-body" class="max-h-[32rem] overflow-auto p-4 font-mono text-sm leading-relaxed text-soft-linen-100"></pre>
        </div>
    </section>

    <footer class="mt-16 text-center text-sm text-soft-linen-500">
        Tip: add <code class="rounded bg-soft-linen-900 px-1.5 py-0.5 font-mono text-soft-linen-200">?_embed=&lt;route&gt;</code> to any request to include related records.
    </footer>
</main>

<script>
    const result = document.getElementById('result');
    const resultUrl = document.getElementById('result-url');
    const resultStatus = document.getElementById('result-status');
    const resultBody = document.getElementById('result-body');
    const resultMethod = document.getElementById('result-method');

    async function run(url, options = {}) {
        result.classList.remove('hidden');
        resultUrl.textContent = url;
        resultUrl.href = url;
        resultMethod.textContent = options.method || 'GET';
        resultStatus.textContent = 'Loading…';
        resultStatus.className = 'font-mono text-soft-linen-400';
        resultBody.textContent = '';

        try {
            const res = await fetch(url, options);
            const text = await res.text();
            resultStatus.textContent = `${res.status} ${res.statusText}`;
            resultStatus.className = `font-mono ${res.ok ? 'text-soft-linen-200' : 'text-rich-mahogany-300'}`;
            try {
                resultBody.textContent = JSON.stringify(JSON.parse(text), null, 2);
            } catch {
                resultBody.textContent = text;
            }
        } catch (error) {
            resultStatus.textContent = 'Request failed';
            resultStatus.className = 'font-mono text-rich-mahogany-300';
            resultBody.textContent = error.message;
        }

        result.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    const routeNames = [...document.querySelectorAll('.embed-select')].map(select => select.dataset.route);

    // Embed choices: every other configured route
    document.querySelectorAll('.embed-select').forEach(select => {
        routeNames
            .filter(name => name !== select.dataset.route)
            .forEach(name => select.add(new Option(name, name)));
    });

    // Records per route, so the PUT body can be filled with the chosen record
    const recordsByRoute = {};

    // Shows a record's fields (minus its id) as JSON in a textarea
    function fillBody(textarea, record) {
        const { id, ...fields } = record;
        textarea.value = JSON.stringify(fields, null, 2);
    }

    // Id choices: loaded from the existing GET /:route endpoint
    routeNames.forEach(async route => {
        const idSelect = document.getElementById(`id-${route}`);
        const putSelect = document.getElementById(`put-id-${route}`);
        const deleteSelect = document.getElementById(`delete-id-${route}`);

        try {
            const res = await fetch(`/${route}`);
            const { data } = await res.json();
            recordsByRoute[route] = data;

            // Sort choices: every field name used by this route's records
            const fields = new Set(data.flatMap(item => Object.keys(item)));
            fields.forEach(field => document.getElementById(`sort-${route}`).add(new Option(field, field)));

            // Show the name, but keep the UUID as the option's value
            data.forEach(item => {
                const label = item.name || item.id;
                idSelect.add(new Option(label, item.id));
                putSelect.add(new Option(label, item.id));
                deleteSelect.add(new Option(label, item.id));
            });

            // Pre-fill the POST and PUT bodies with the first record
            if (data.length > 0) {
                fillBody(document.getElementById(`body-${route}`), data[0]);
                fillBody(document.getElementById(`put-body-${route}`), data[0]);
            }
        } catch {
            idSelect.add(new Option('n/a', ''));
            putSelect.add(new Option('n/a', ''));
            deleteSelect.add(new Option('n/a', ''));
        }
    });

    // Picking another id for PUT loads that record into the textarea
    document.querySelectorAll('.put-id-select').forEach(select => {
        select.addEventListener('change', () => {
            const { route } = select.dataset;
            const record = (recordsByRoute[route] || []).find(item => String(item.id) === select.value);
            if (record) {
                fillBody(document.getElementById(`put-body-${route}`), record);
            }
        });
    });

    function buildUrl(button, withId) {
        const { route, embed } = button.dataset;
        let url = `/${route}`;
        const params = new URLSearchParams();

        if (withId) {
            url += `/${encodeURIComponent(document.getElementById(`id-${route}`).value)}`;
        }
        if (embed) {
            params.set('_embed', document.getElementById(`embed-${route}`).value);
        }

        // Sorting only applies to "Get all"
        const sort = document.getElementById(`sort-${route}`).value;
        if (!withId && sort) {
            params.set('_sort', sort);
            params.set('_order', document.getElementById(`order-${route}`).value);
        }

        // Only add the "?" when there is at least one parameter
        return params.size > 0 ? `${url}?${params}` : url;
    }

    document.querySelectorAll('.run-all').forEach(button => {
        button.addEventListener('click', () => run(buildUrl(button, false)));
    });

    document.querySelectorAll('.run-id').forEach(button => {
        button.addEventListener('click', () => run(buildUrl(button, true)));
    });

    document.querySelectorAll('.run-post').forEach(button => {
        button.addEventListener('click', () => {
            const { route } = button.dataset;
            run(`/${route}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: document.getElementById(`body-${route}`).value
            });
        });
    });

    document.querySelectorAll('.run-put').forEach(button => {
        button.addEventListener('click', () => {
            const { route } = button.dataset;
            const id = document.getElementById(`put-id-${route}`).value;
            run(`/${route}/${encodeURIComponent(id)}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: document.getElementById(`put-body-${route}`).value
            });
        });
    });

    document.querySelectorAll('.run-delete').forEach(button => {
        button.addEventListener('click', () => {
            const { route } = button.dataset;
            const select = document.getElementById(`delete-id-${route}`);
            const id = select.value;
            const name = select.selectedOptions[0]?.text;

            // Deleting changes the data, so ask first
            if (!confirm(`Delete ${name} from ${route}?`)) return;

            run(`/${route}/${encodeURIComponent(id)}`, { method: 'DELETE' });
        });
    });
</script>
</body>
</html>
